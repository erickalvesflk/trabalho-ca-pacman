{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar Projeto C",
            "command": "C:\\msys64\\ucrt64\\bin\\gcc.exe",
            "args": [
                "-g",

                "-I${workspaceFolder}/include",
                "-IC:/msys64/ucrt64/include",

                "${workspaceFolder}/src/main.c",
                "${workspaceFolder}/src/grafico_jogo.c",
                "${workspaceFolder}/src/geranciador_de_mapa.c",
                "${workspaceFolder}/src/entidades.c",
                "${workspaceFolder}/src/fantasmas.c",

                "-LC:/msys64/ucrt64/lib",
                "-lraylib",

                "-lopengl32",
                "-lgdi32",
                "-lwinmm",

                "-o",
                "${workspaceFolder}/build/pacman.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
