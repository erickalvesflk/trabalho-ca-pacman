{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar Projeto C",
            "command": "gcc",
            "args": [
                "-g",                        
                "-Iinclude",                 
                "${workspaceFolder}/src/*.c", 
                "-o",
                "${workspaceFolder}/build/pacman"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}
